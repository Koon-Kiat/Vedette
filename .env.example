# Copy to .env and fill in. .env is git-ignored: never commit it.
# This file documents every environment variable the Sentinel reads today.

# --- Secrets -----------------------------------------------------------------
# NextDNS API key (bottom of https://my.nextdns.io/account). Sent only to
# api.nextdns.io in the X-Api-Key header and redacted from all logs.
# May instead be supplied as a Docker secret named NEXTDNS_API_KEY.
NEXTDNS_API_KEY=

# Notification secrets: set only the ones for notify.channel in config.yaml.
# All are redacted from logs and may instead be Docker secrets of the same name.
# ntfy: the topic acts as a password on a public server, so make it long and
# random (letters, digits, - and _ only). The token is optional.
NTFY_TOPIC=
NTFY_TOKEN=
# Discord: Server Settings > Integrations > Webhooks > Copy Webhook URL.
DISCORD_WEBHOOK_URL=
# E-mail: the SMTP password (for Gmail, an app password).
SMTP_PASSWORD=

# --- Runtime -----------------------------------------------------------------
# Path of the YAML config file inside the container. docker-compose.yml already
# sets this to /config/config.yaml; change it only when running outside Compose.
# SENTINEL_CONFIG_FILE=/config/config.yaml

# Log verbosity: DEBUG, INFO, WARNING or ERROR.
# SENTINEL_LOG_LEVEL=INFO

# --- Overrides for config.yaml -------------------------------------------------
# Any config.yaml value can be overridden: prefix SENTINEL_, and put "__" between
# nesting levels. Lists take JSON. Examples (all optional):
# SENTINEL_TIMEZONE=Asia/Singapore
# SENTINEL_INGEST__BACKFILL_DAYS=7
# SENTINEL_INGEST__RAW=false
# SENTINEL_INGEST__PAGE_SIZE=1000
# SENTINEL_STORAGE__DATABASE_URL=sqlite+aiosqlite:////data/sentinel.db
# SENTINEL_ENRICH__POPULARITY__URL=https://tranco-list.eu/top-1m.csv.zip
# SENTINEL_ENRICH__POPULARITY__REFRESH_DAYS=7
# SENTINEL_ENRICH__RDAP__ENABLED=true
# SENTINEL_ENRICH__RDAP__BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
# SENTINEL_ENRICH__RDAP__MAX_EVENT_AGE_HOURS=24
# SENTINEL_ENRICH__RDAP__MAX_LOOKUPS_PER_BATCH=20
# SENTINEL_ENRICH__THREAT_INTEL__REFRESH_HOURS=24
# SENTINEL_ENRICH__THREAT_INTEL__FEEDS=[{"name":"cert_pl","url":"https://hole.cert.pl/domains/v2/domains.txt","format":"domains"}]
# SENTINEL_RULES__FILE=/config/rules.yaml
# SENTINEL_RULES__LEARNING_DAYS=3
# SENTINEL_ALLOWLIST=[{"root":"example.com"}]
# SENTINEL_LLM__BASE_URL=http://ollama:11434
# SENTINEL_LLM__MODEL=qwen3:8b
# SENTINEL_LLM__THINK=false
# SENTINEL_LLM__TEMPERATURE=0.1
# SENTINEL_LLM__NUM_CTX=8192
# SENTINEL_LLM__KEEP_ALIVE=5m
# SENTINEL_LLM__MAX_FINDINGS_PER_BATCH=20
# SENTINEL_LLM__CACHE_TTL_HOURS=168
# SENTINEL_NOTIFY__CHANNEL=none
# SENTINEL_NOTIFY__DIGEST_TIME=08:00
# SENTINEL_NOTIFY__QUIET_HOURS=23:00-07:00
# SENTINEL_NOTIFY__ALERT_COOLDOWN_MINUTES=60
# SENTINEL_NOTIFY__ALERT_MAX_AGE_MINUTES=60
# SENTINEL_NOTIFY__ANALYSIS_WAIT_SECONDS=60
# SENTINEL_NOTIFY__NTFY__URL=https://ntfy.sh
# SENTINEL_NOTIFY__EMAIL__HOST=smtp.example.org
# SENTINEL_NOTIFY__EMAIL__PORT=587
# SENTINEL_NOTIFY__EMAIL__SECURITY=starttls
# SENTINEL_NOTIFY__EMAIL__USERNAME=me@example.org
# SENTINEL_NOTIFY__EMAIL__SENDER=me@example.org
# SENTINEL_NOTIFY__EMAIL__RECIPIENTS=["me@example.org"]
# SENTINEL_HEALTH__CHECK_INTERVAL_SECONDS=60
# SENTINEL_HEALTH__STALE_AFTER_MINUTES=120
# SENTINEL_HEALTH__API_ERROR_MINUTES=5
# SENTINEL_HEALTH__OLLAMA_DOWN_MINUTES=5
# SENTINEL_HEALTH__MAX_BACKLOG_EVENTS=20000
# SENTINEL_HEALTH__BACKLOG_MINUTES=15
# SENTINEL_HEALTH__MAX_DISK_PERCENT=90
# SENTINEL_HEALTH__HEALTHZ_PORT=8081
# SENTINEL_RETENTION__EVENTS_DAYS=30
# SENTINEL_RETENTION__FINDINGS_DAYS=180
# SENTINEL_NEXTDNS_WRITE_ENABLED=false
# SENTINEL_PROFILES=[{"id":"abc123","label":"router","enabled":true}]
#
# SENTINEL_LLM__MODEL is also read by Compose to decide which model the
# one-shot "ollama-pull" helper downloads.
