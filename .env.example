# Copy to .env and fill in. .env is git-ignored: never commit it.
# This file documents every environment variable Vedette reads today.

# --- Secrets -----------------------------------------------------------------
# NextDNS API key (bottom of https://my.nextdns.io/account). Sent only to
# api.nextdns.io in the X-Api-Key header and redacted from all logs.
# May instead be supplied as a Docker secret named NEXTDNS_API_KEY.
NEXTDNS_API_KEY=

# Dashboard login token, at least 24 characters. Without it the dashboard stays
# off. Generate one with:
#   docker compose run --rm --no-deps --entrypoint python vedette -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=

# Notification secrets: set only the ones for notify.channel in config.yaml.
# All are redacted from logs and may instead be Docker secrets of the same name.
# ntfy: the topic acts as a password on a public server, so make it long and
# random (letters, digits, - and _ only). The token is optional.
NTFY_TOPIC=
NTFY_TOKEN=
# Discord: Server Settings > Integrations > Webhooks > Copy Webhook URL.
DISCORD_WEBHOOK_URL=
# E-mail: the SMTP password (for Gmail, an app password).
SMTP_PASSWORD=

# Optional dead man's switch (healthchecks.io, Uptime Kuma, ...): pinged while
# Vedette runs and its alerts get out, so the service warns you when it stops.
# https only (http just for a server on the local Docker network). A secret:
# redacted from logs, may instead be a Docker secret of the same name.
HEARTBEAT_URL=

# --- Image ---------------------------------------------------------------------
# Read by docker-compose.yml, not by Vedette: run a released image instead of
# building one locally. See "Releases" in the README.
# VEDETTE_IMAGE=ghcr.io/koon-kiat/vedette:0.1.0

# --- Runtime -----------------------------------------------------------------
# Path of the YAML config file inside the container. docker-compose.yml already
# sets this to /config/config.yaml; change it only when running outside Compose.
# VEDETTE_CONFIG_FILE=/config/config.yaml

# Log verbosity: DEBUG, INFO, WARNING or ERROR.
# VEDETTE_LOG_LEVEL=INFO

# --- Overrides for config.yaml -------------------------------------------------
# Any config.yaml value can be overridden: prefix VEDETTE_, and put "__" between
# nesting levels. Lists take JSON. Examples (all optional):
# VEDETTE_TIMEZONE=Europe/Berlin
# VEDETTE_INGEST__BACKFILL_DAYS=7
# VEDETTE_INGEST__RAW=false
# VEDETTE_INGEST__PAGE_SIZE=1000
# VEDETTE_STORAGE__DATABASE_URL=sqlite+aiosqlite:////data/vedette.db
# VEDETTE_ENRICH__POPULARITY__URL=https://tranco-list.eu/top-1m.csv.zip
# VEDETTE_ENRICH__POPULARITY__REFRESH_DAYS=7
# VEDETTE_ENRICH__RDAP__ENABLED=true
# VEDETTE_ENRICH__RDAP__BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
# VEDETTE_ENRICH__RDAP__MAX_EVENT_AGE_HOURS=24
# VEDETTE_ENRICH__RDAP__MAX_LOOKUPS_PER_BATCH=20
# VEDETTE_ENRICH__THREAT_INTEL__REFRESH_HOURS=24
# VEDETTE_ENRICH__THREAT_INTEL__FEEDS=[{"name":"cert_pl","url":"https://hole.cert.pl/domains/v2/domains.txt","format":"domains"}]
# VEDETTE_RULES__FILE=/config/rules.yaml
# VEDETTE_RULES__LEARNING_DAYS=3
# VEDETTE_ALLOWLIST=[{"root":"example.com"}]
# VEDETTE_LLM__BASE_URL=http://ollama:11434
# VEDETTE_LLM__MODEL=qwen3:8b
# VEDETTE_LLM__THINK=false
# VEDETTE_LLM__TEMPERATURE=0.1
# VEDETTE_LLM__NUM_CTX=8192
# VEDETTE_LLM__KEEP_ALIVE=5m
# VEDETTE_LLM__MAX_FINDINGS_PER_BATCH=20
# VEDETTE_LLM__CACHE_TTL_HOURS=168
# VEDETTE_NOTIFY__CHANNEL=none
# VEDETTE_NOTIFY__DIGEST_TIME=08:00
# VEDETTE_NOTIFY__QUIET_HOURS=23:00-07:00
# VEDETTE_NOTIFY__ALERT_COOLDOWN_MINUTES=60
# VEDETTE_NOTIFY__ALERT_MAX_AGE_MINUTES=60
# VEDETTE_NOTIFY__ANALYSIS_WAIT_SECONDS=60
# VEDETTE_NOTIFY__NTFY__URL=https://ntfy.sh
# VEDETTE_NOTIFY__EMAIL__HOST=smtp.example.org
# VEDETTE_NOTIFY__EMAIL__PORT=587
# VEDETTE_NOTIFY__EMAIL__SECURITY=starttls
# VEDETTE_NOTIFY__EMAIL__USERNAME=me@example.org
# VEDETTE_NOTIFY__EMAIL__SENDER=me@example.org
# VEDETTE_NOTIFY__EMAIL__RECIPIENTS=["me@example.org"]
# VEDETTE_HEALTH__CHECK_INTERVAL_SECONDS=60
# VEDETTE_HEALTH__STALE_AFTER_MINUTES=120
# VEDETTE_HEALTH__API_ERROR_MINUTES=5
# VEDETTE_HEALTH__OLLAMA_DOWN_MINUTES=5
# VEDETTE_HEALTH__MAX_BACKLOG_EVENTS=20000
# VEDETTE_HEALTH__BACKLOG_MINUTES=15
# VEDETTE_HEALTH__MAX_DISK_PERCENT=90
# VEDETTE_HEALTH__HEALTHZ_PORT=8081
# VEDETTE_HEALTH__HEARTBEAT_MINUTES=5
# VEDETTE_DASHBOARD__ENABLED=true
# VEDETTE_DASHBOARD__HOST=127.0.0.1
# VEDETTE_DASHBOARD__PORT=8080
# VEDETTE_DASHBOARD__SESSION_HOURS=12
# VEDETTE_DASHBOARD__ALLOWED_HOSTS=["127.0.0.1","localhost"]
# VEDETTE_RETENTION__EVENTS_DAYS=30
# VEDETTE_RETENTION__FINDINGS_DAYS=180
# VEDETTE_NEXTDNS_WRITE_ENABLED=false
# VEDETTE_PROFILES=[{"id":"abc123","label":"router","enabled":true}]
#
# VEDETTE_DASHBOARD__HOST is where the dashboard listens inside the process.
# docker-compose.yml sets it to 0.0.0.0 inside the container and publishes
# the port on 127.0.0.1 only.
#
# VEDETTE_LLM__MODEL is also read by Compose to decide which model the
# one-shot "ollama-pull" helper downloads.
